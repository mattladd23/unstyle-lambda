{
    "compilerOptions": {
      "module": "ESNext",
      "esModuleInterop": true,
      "target": "ES2020",
      "moduleResolution": "Node",
      "sourceMap": true,
      "strict": true,
      "rootDir": "src",
      "outDir": "dist",
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true
    },    
    "lib": ["es2015"],
    "include": ["src/index.mts"],
  }
  